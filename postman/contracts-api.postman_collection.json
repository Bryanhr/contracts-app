{
  "info": {
    "name": "Contracts API - Semana 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. La primera petición comprueba CORS para Angular en http://localhost:4200. Luego el login guarda el JWT. Clientes, contratos y las escrituras lo envían en Authorization. GET de planes y plantillas es público."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "angularOrigin",
      "value": "http://localhost:4200"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ruc",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "contractId",
      "value": ""
    },
    {
      "key": "templateId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 OPTIONS preflight Angular",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "{{angularOrigin}}"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "GET"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "Authorization"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "customers"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Allows the Angular origin\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(pm.collectionVariables.get(\"angularOrigin\")));",
              "pm.test(\"Allows the Authorization header\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Headers\")).to.include(\"Authorization\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "00 POST login",
      "request": {
        "description": "Usuarios simulados: admin@empresa.pe / admin123, gerente@empresa.pe / gerente123, ventas1@empresa.pe / ventas123.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@empresa.pe\",\n  \"password\": \"admin123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Returns a token\", () => pm.expect(body.token).to.be.a(\"string\").that.is.not.empty);",
              "pm.collectionVariables.set(\"token\", body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "01 POST customer (valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "customers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"businessName\": \"Soporte Andino SAC\",\n  \"ruc\": \"{{ruc}}\",\n  \"representative\": \"Ana Torres\",\n  \"email\": \"contacto@soporteandino.pe\",\n  \"phone\": \"987654321\",\n  \"address\": \"Av. Arequipa 123, Lima\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"ruc\", \"20\" + String(Date.now()).slice(-9));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const c = pm.response.json();",
              "pm.test(\"Has id and same RUC\", () => { pm.expect(c.id).to.be.a(\"number\"); pm.expect(c.ruc).to.eql(pm.collectionVariables.get(\"ruc\")); });",
              "pm.collectionVariables.set(\"customerId\", c.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 POST customer without RUC",
      "request": {
        "method": "POST",
        "header": [
          {
