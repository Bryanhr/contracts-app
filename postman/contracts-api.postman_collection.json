          "mode": "raw",
          "raw": "{\n  \"customerId\": {{customerId}},\n  \"planId\": {{planId}},\n  \"startDate\": \"2026-11-01\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const k = pm.response.json();",
              "pm.collectionVariables.set(\"contractId\", k.id);",
              "pm.test(\"Amount copied from plan\", () => pm.expect(Number(k.amount)).to.eql(350));",
              "pm.test(\"End date = start + 12 months\", () => pm.expect(k.endDate).to.eql(\"2027-11-01\"));",
              "pm.test(\"Starts GENERATED without validity\", () => { pm.expect(k.status).to.eql(\"GENERATED\"); pm.expect(k.validity).to.be.null; });"
            ]
          }
        }
      ]
    },
